# --- OpenRouter (required for AI classification + narrative; without it the app uses built-in rules) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Public URL of the app, sent to OpenRouter as HTTP-Referer for attribution
APP_URL=https://intent.example.com

# --- Optional tuning ---
# LLM_TIMEOUT_MS=60000
# LLM_CLASSIFY_LIMIT=400
# LLM_DISABLED=1
# MAX_FILE_MB=25
# MAX_TOTAL_MB=95
# MAX_FILES=12
# RATE_LIMIT_PER_10MIN=20

# --- Docker Compose + Cloudflare Tunnel option only ---
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...
